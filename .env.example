# Copy to .env and fill in your own credentials. Never commit .env.
NODE_ENV=development
PORT=3002
CORS_ORIGINS=http://localhost:5173,http://localhost:3002

# Admin is created on first start only when this contains at least 12 characters.
DEFAULT_ADMIN_PASSWORD=

# Google Sheets API; the second key is optional.
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
SHEET1_ID=
SHEET2_ID=

# Enable CAPTCHA only after configuring both keys and allowed hostnames.
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional Discord login and guild integration.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3002/api/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
